# Salin menjadi .env lalu isi GROQ_API_KEY milik backend.
# File .env tidak boleh di-commit dan tidak boleh dikirim ke browser.
GROQ_API_KEY=isi_dengan_api_key_groq
EMBEDDING_PROVIDER=local
PORT=8001
MAX_QUESTION_LENGTH=1000

# Opsional bila EMBEDDING_PROVIDER=api.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small
